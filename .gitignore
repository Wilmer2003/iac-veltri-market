# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version
# control as they are data points which are potentially sensitive and subject
# to change depending on the environment.
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
# example: *tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Optional: ignore graph output files generated by `terraform graph`
# *.dot

# Optional: ignore plan files saved before destroying Terraform configuration
# Uncomment the line below if you want to ignore planout files.
# planout


·······································································

# =============================================================================
# .gitignore — Veltri Infra
# =============================================================================
# Estos archivos NO se suben al repositorio de GitHub porque contienen
# información sensible o son generados automáticamente por Terraform/AWS.
# =============================================================================

# -----------------------------------------------------------------------------
# Terraform — Archivos locales generados automáticamente
# -----------------------------------------------------------------------------

# Directorio con plugins descargados (muy pesado, >100MB)
# Cada miembro del equipo los descarga con "terraform init"
.terraform/
.terraform.lock.hcl

# Estado de Terraform LOCAL — NUNCA subir al repo si contiene datos reales
# El tfstate se guarda en S3 (backend remoto) para trabajo grupal
*.tfstate
*.tfstate.backup
*.tfstate.*.backup

# Variables con valores sensibles (contraseñas, API keys)
# Crear este archivo localmente pero NUNCA subirlo
*.tfvars
!*.tfvars.example    # Los archivos .example SÍ se suben como plantilla

# Archivos de plan guardados (pueden contener info sensible)
*.tfplan

# Override files — configuraciones locales temporales
override.tf
override.tf.json
*_override.tf
*_override.tf.json


# -----------------------------------------------------------------------------
# AWS — Credenciales y configuración local
# -----------------------------------------------------------------------------

# Credenciales AWS — JAMÁS subir al repo
.aws/
credentials
*.pem
*.key

# Variables de entorno locales
.env
.env.local
.env.dev
.env.prod


# -----------------------------------------------------------------------------
# Sistema operativo
# -----------------------------------------------------------------------------

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Desktop.ini

# Linux
*~


# -----------------------------------------------------------------------------
# IDEs y editores
# -----------------------------------------------------------------------------

# VSCode
.vscode/
*.code-workspace

# JetBrains (PyCharm, IntelliJ)
.idea/
*.iml

# Vim
*.swp
*.swo


# -----------------------------------------------------------------------------
# Python / Django (para el directorio backend/)
# -----------------------------------------------------------------------------

__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
env/
venv/
.venv/
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/


# -----------------------------------------------------------------------------
# Docker
# -----------------------------------------------------------------------------

# No subir imágenes Docker construidas localmente
*.tar


# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------

*.log
logs/
